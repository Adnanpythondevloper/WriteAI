# WriteAI – Smart AI Writer Environment Configuration Example
# Server-side Gemini API Key (Required for production AI backend)
GEMINI_API_KEY=YOUR_PRODUCTION_KEY

# Google Mobile Ads / AdMob Switch & Production Unit IDs
# Set to "true" only when building for production Google Play release. Default is false (uses Google official TEST IDs).
VITE_ADMOB_IS_PRODUCTION=false
VITE_ADMOB_APP_ID=ca-app-pub-YOUR_PRODUCTION_APP_ID_HERE~0000000000
VITE_ADMOB_BANNER_ID=ca-app-pub-YOUR_PRODUCTION_APP_ID_HERE/BANNER_ID_HERE
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-YOUR_PRODUCTION_APP_ID_HERE/INTERSTITIAL_ID_HERE
VITE_ADMOB_REWARDED_ID=ca-app-pub-YOUR_PRODUCTION_APP_ID_HERE/REWARDED_ID_HERE
